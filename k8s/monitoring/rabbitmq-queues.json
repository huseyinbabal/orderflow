{
 "title": "RabbitMQ Queues",
 "uid": "rabbitmq-queues",
 "tags": [
  "rabbitmq",
  "orderflow"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "queue",
    "label": "Queue",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(rabbitmq_queue_messages_ready, queue)",
     "refId": "q"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 0,
   "type": "timeseries",
   "title": "Ready messages",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "targets": [
    {
     "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\"$queue\"})",
     "legendFormat": "{{queue}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "Unacked messages",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "targets": [
    {
     "expr": "sum by (queue) (rabbitmq_queue_messages_unacked{queue=~\"$queue\"})",
     "legendFormat": "{{queue}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Publish rate (msg/s)",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "mps",
     "custom": {
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "targets": [
    {
     "expr": "sum by (queue) (rate(rabbitmq_queue_messages_published_total{queue=~\"$queue\"}[1m]))",
     "legendFormat": "{{queue}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Deliver+ack rate (msg/s)",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "mps",
     "custom": {
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "targets": [
    {
     "expr": "sum by (queue) (rate(rabbitmq_queue_messages_delivered_ack_total{queue=~\"$queue\"}[1m]) + rate(rabbitmq_queue_messages_delivered_total{queue=~\"$queue\"}[1m]))",
     "legendFormat": "{{queue}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ]
}