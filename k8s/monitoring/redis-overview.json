{
  "uid": "redis-orderflow",
  "title": "Redis Streams / OrderFlow Overview",
  "tags": ["redis", "streams", "orderflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stream length — feed (MAXLEN ~100k)",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 150000 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        { "expr": "redis_stream_length{stream=\"feed\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PEL — unacked entries (dashboard)",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        { "expr": "sum(redis_stream_group_messages_pending{stream=\"feed\", group=\"dashboard\"})", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Group consumers (pods in the group)",
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "targets": [
        { "expr": "redis_stream_group_consumers{stream=\"feed\", group=\"dashboard\"}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PEL over time — a rising floor means the sweeper is losing",
      "gridPos": { "h": 10, "w": 14, "x": 10, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 14, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(redis_stream_group_messages_pending{stream=\"feed\", group=\"dashboard\"})",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Publish vs consume rate — feed (entries/s)",
      "gridPos": { "h": 10, "w": 10, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" },
          "unit": "cps"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(redis_commands_total{cmd=\"xadd\"}[1m]))",
          "legendFormat": "XADD (published)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(redis_stream_group_entries_read{stream=\"feed\", group=\"dashboard\"}[1m]))",
          "legendFormat": "consumed (dashboard)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer group lag — feed / dashboard",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(redis_stream_group_lag{stream=\"feed\", group=\"dashboard\"})",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis memory used (the feed's retention budget)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "redis_memory_max_bytes", "legendFormat": "maxmemory", "refId": "B" }
      ]
    }
  ]
}
